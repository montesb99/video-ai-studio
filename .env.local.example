# Supabase — panel del proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vault de integraciones — cifra las claves BYOK (HeyGen, ElevenLabs, OpenAI)
# antes de guardarlas en `integrations`. Generar con: openssl rand -base64 32
# Nunca subir el valor real a git ni al panel de secretos sin rotarlo si se filtra.
INTEGRATIONS_KEK=

# Las claves de HeyGen/ElevenLabs/OpenAI NO van aquí: son BYOK por workspace,
# el usuario las pega en /integrations y quedan cifradas en la base de datos.

# Claude — clave de plataforma, usada por lib/providers/claude.ts para
# ideación, guion y ediciones asistidas. Desde Sprint 3 Parte E es el
# RESPALDO: si el workspace conecta su propia clave de Anthropic o de Gemini
# en /integrations, esa BYOK tiene prioridad (docs/03-INTEGRATIONS.md
# "BYOK opcional (Sprint 3 Parte E)", lib/pipeline/llm-provider.ts#resolveGenerator).
# Sin esta variable, los workspaces sin BYOK propia no pueden generar ideas/guion.
ANTHROPIC_API_KEY=

# Gemini (BYOK, alternativa gratuita a Claude) NO tiene variable de entorno de
# plataforma: solo se usa si el workspace conecta su propia clave de Google AI
# Studio en /integrations. Sin BYOK de Gemini, esa opción simplemente no
# aparece como conectada — no hay fallback de plataforma para Gemini.
