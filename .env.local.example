# Supabase — panel del proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vault de integraciones — cifra las claves BYOK (HeyGen, ElevenLabs, OpenAI)
# antes de guardarlas en `integrations`. Generar con: openssl rand -base64 32
# Nunca subir el valor real a git ni al panel de secretos sin rotarlo si se filtra.
INTEGRATIONS_KEK=

# Las claves de HeyGen/ElevenLabs/OpenAI NO van aquí: son BYOK por workspace,
# el usuario las pega en /integrations y quedan cifradas en la base de datos.

# Claude — "nuestra" clave, no BYOK (docs/03-INTEGRATIONS.md). Usada por
# lib/providers/claude.ts para ideación, guion y ediciones asistidas.
ANTHROPIC_API_KEY=
