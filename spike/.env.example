# Copia este archivo a spike/.env y rellena tus claves.
# NUNCA pegues estas claves en el chat. Los scripts las leen de aquí.

# --- Paso 1 y 4 ---
HEYGEN_API_KEY=

# --- Paso 2 y 3 ---
ELEVENLABS_API_KEY=

# --- Se rellenan tras correr los pasos 1 y 2 ---
# El look_id que el paso 1 marque como compatible con avatar_iii + matting
HEYGEN_LOOK_ID=
# El voice_id de tu voz profesional clonada, del paso 2
ELEVENLABS_VOICE_ID=

# --- Opcionales ---
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
